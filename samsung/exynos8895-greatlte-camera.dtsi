	};

	fimc_is_mclk3_fn: fimc-is-mclk3-fn-pins {
		samsung,pins = "gpk0-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV3>;
	};

	fimc_is_spi_pin0_out: fimc-is-spi-pin0-out-pins {
		samsung,pins = "gpc3-3", "gpc3-2", "gpc3-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	fimc_is_spi_pin0_fn: fimc-is-spi-pin0-fn-pins {
		samsung,pins = "gpc3-3", "gpc3-2", "gpc3-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	fimc_is_spi_ssn0_out: fimc-is-spi-ssn0-out-pins {
		samsung,pins = "gpc3-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	fimc_is_spi_ssn0_inpd: fimc-is-spi-ssn0-inpd-pins {
		samsung,pins = "gpc3-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};

	fimc_is_spi_ssn0_inpu: fimc-is-spi-ssn0-inpu-pins {
		samsung,pins = "gpc3-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};

	fimc_is_spi_ssn0_fn: fimc-is-spi-ssn0-fn-pins {
		samsung,pins = "gpc3-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};

	fimc_is_spi_pin1_out: fimc-is-spi-pin1-out-pins {
		samsung,pins = "gpc3-7", "gpc3-6", "gpc3-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	fimc_is_spi_pin1_fn: fimc-is-spi-pin1-fn-pins {
		samsung,pins = "gpc3-7", "gpc3-6", "gpc3-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	fimc_is_spi_ssn1_out: fimc-is-spi-ssn1-out-pins {
		samsung,pins = "gpc3-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	fimc_is_spi_ssn1_fn: fimc-is-spi-ssn1-fn-pins {
		samsung,pins = "gpc3-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};

	sub_cam_1p0_out: sub-cam-1p0-out-pins {
		samsung,pins = "gpe6-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	fimc_is_comp_int_in: fimc-is-comp-int-in-pins {
		samsung,pins = "gpc0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	fimc_is_comp_int_fn: fimc-is-comp-int-fn-pins {
		samsung,pins = "gpc0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};
};

&spi_0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default", "spi_out", "spi_fn";
	pinctrl-0 = <&fimc_is_spi_pin0_out>;
	pinctrl-1 = <&fimc_is_spi_pin0_out>;
	pinctrl-2 = <&fimc_is_spi_pin0_fn>;
	cs-gpios = <&gpc3 1 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	swap-mode;
	assigned-clocks = <&cmu_top CLK_DOUT_CMU_PERIC1_SPI_CAM0>,
			  <&cmu_peric1 CLK_MOUT_PERIC1_SPI_CAM0_USER>;
	assigned-clock-parents = <0>, <&cmu_top CLK_DOUT_CMU_PERIC1_SPI_CAM0>;
	assigned-clock-rates = <100000000>, <0>;
	status = "okay";

	fimc_is_spi_0@0 {
		compatible = "samsung,fimc_is_spi0";
		spi-max-frequency = <0x2faf080>;
		reg = <0x00>;
		pinctrl-names = "default", "ssn_out", "ssn_fn", "ssn_inpd", "ssn_inpu";
		pinctrl-0 = <&fimc_is_spi_ssn0_out>;
		pinctrl-1 = <&fimc_is_spi_ssn0_out>;
		pinctrl-2 = <&fimc_is_spi_ssn0_fn>;
		pinctrl-3 = <&fimc_is_spi_ssn0_inpd>;
		pinctrl-4 = <&fimc_is_spi_ssn0_inpu>;
		use_spi_pinctrl;

		controller-data {
			samsung,spi-feedback-delay = <0x01>;
		};
	};
};

&spi_1 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default", "spi_out", "spi_fn";
	pinctrl-0 = <&fimc_is_spi_pin1_out>;
	pinctrl-1 = <&fimc_is_spi_pin1_out>;
	pinctrl-2 = <&fimc_is_spi_pin1_fn>;
	cs-gpios = <&gpc3 5 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	swap-mode;
	assigned-clocks = <&cmu_top CLK_DOUT_CMU_PERIC1_SPI_CAM1>,
			  <&cmu_peric1 CLK_MOUT_PERIC1_SPI_CAM1_USER>;
	assigned-clock-parents = <0>, <&cmu_top CLK_DOUT_CMU_PERIC1_SPI_CAM1>;
	assigned-clock-rates = <100000000>, <0>;
	status = "okay";

	fimc_is_spi_1@0 {
		compatible = "samsung,fimc_is_spi1";
		spi-max-frequency = <0x2faf080>;
		reg = <0x00>;
		pinctrl-names = "default", "ssn_out", "ssn_fn";
		pinctrl-0 = <&fimc_is_comp_int_in &fimc_is_spi_ssn1_out>;
		pinctrl-1 = <&fimc_is_comp_int_in &fimc_is_spi_ssn1_out>;
		pinctrl-2 = <&fimc_is_comp_int_fn &fimc_is_spi_ssn1_fn>;
		use_spi_pinctrl;

		controller-data {
			samsung,spi-feedback-delay = <0x00>;
		};
	};
};

&sysmmu_cam0 {
	status = "okay";
};

&sysmmu_cam1 {
	status = "okay";
};

&sysmmu_dcp {
	status = "okay";
};

&sysmmu_isp {
	status = "okay";
};
