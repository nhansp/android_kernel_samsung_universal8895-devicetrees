/*
 * Samsung Galaxy Note 8 (SM-N950N) camera
 */

#include <dt-bindings/gpio/gpio.h>

/ {
	fimc_is_preprocessor: fimc_is_preprocessor {
		compatible = "samsung,exynos8895-fimc-is-preprocessor";
		power-domains = <&pd_cam>;
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK2>;
		clock-names = "CIS_CLK2";
		scenario = <0>;
		id = <0>;
		mclk_ch = <2>;
	};

	fimc_is_device_companion0 {
		compatible = "samsung,exynos5-fimc-is-device-companion0";
		id = <0x00>;
		product_name = <0x03>;
		gpio_pdaf = <&gpc0 0x00 0x01>;
	};

	fimc_is_device_flash {
		compatible = "samsung,sensor-flash-s2mpb02";
		id = <0x00 0x02>;
		torch-gpio = <&gpc0 0x02 0x01>;
		flash-gpio = <&gpc0 0x01 0x01>;
	};

	fimc-is_sensor_imx260@34 {
		compatible = "samsung,sensor-module-imx260";
		pinctrl-names = "pin0", "pin1", "pin2";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_flash_is &fimc_is_mclk0_fn &fimc_is_mclk2_fn>;
		position = <0x00>;
		id = <0x00>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x00>;
		sensor_i2c_addr = <0x34>;
		gpio_mclk = <&gpk0 0x00 0x01>;
		gpio_reset = <&gpc0 0x04 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		gpio_camio_1p8_en = <&gpe7 0x07 0x01>;
		status = "okay";

		af {
			product_name = <0x0c>;
			i2c_addr = <0x18>;
			i2c_ch = <0x02>;
		};

		flash {
			product_name = <0x03>;
			flash_first_gpio = <0x01>;
			flash_second_gpio = <0x02>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x02>;
			i2c_addr = <0x48>;
			i2c_ch = <0x01>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	fimc-is_sensor_imx333@34 {
		compatible = "samsung,sensor-module-imx333";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_flash_is &fimc_is_mclk0_fn &fimc_is_mclk2_fn>;
		pinctrl-3 = <&ois_rst_out &cam_rst_out &comp_rst_out>;
		pinctrl-4;
		position = <0x00>;
		id = <0x00>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x00>;
		sensor_i2c_addr = <0x34>;
		gpio_mclk = <&gpk0 0x00 0x01>;
		gpio_reset = <&gpc0 0x04 0x01>;
		gpio_ois_reset = <&gpc1 0x00 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		gpio_cam_af_2p8_en = <&gpf1 0x00 0x01>;
		gpio_camio_1p8_en = <&gpe7 0x07 0x01>;
		power_seq_id = <0x01>;
		status = "okay";

		af {
			product_name = <0x0c>;
			i2c_addr = <0x18>;
			i2c_ch = <0x01>;
		};

		flash {
			product_name = <0x03>;
			flash_first_gpio = <0x01>;
			flash_second_gpio = <0x02>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x02>;
			i2c_addr = <0x48>;
			i2c_ch = <0x01>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	fimc-is_sensor_2l2@5A {
		compatible = "samsung,sensor-module-2l2";
		pinctrl-names = "pin0", "pin1", "pin2", "pin3", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_flash_is &fimc_is_mclk0_fn &fimc_is_mclk2_fn>;
		pinctrl-3 = <&fimc_is_mclk0_fn>;
		pinctrl-4 = <&ois_rst_out &cam_rst_out &comp_rst_out>;
		pinctrl-5;
		position = <0x00>;
		id = <0x00>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x00>;
		sensor_i2c_addr = <0x5a>;
		gpio_mclk = <&gpk0 0x00 0x01>;
		gpio_reset = <&gpc0 0x04 0x01>;
		gpio_ois_reset = <&gpc1 0x00 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		gpio_cam_af_2p8_en = <&gpf1 0x00 0x01>;
		gpio_camio_1p8_en = <&gpe7 0x07 0x01>;
		power_seq_id = <0x01>;
		status = "okay";

		af {
			product_name = <0x0c>;
			i2c_addr = <0x18>;
			i2c_ch = <0x01>;
		};

		flash {
			product_name = <0x03>;
			flash_first_gpio = <0x01>;
			flash_second_gpio = <0x02>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x02>;
			i2c_addr = <0x48>;
			i2c_ch = <0x01>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	fimc-is_sensor_3m3@5A {
		compatible = "samsung,sensor-module-3m3";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_flash_is &fimc_is_mclk0_fn &fimc_is_mclk2_fn>;
		pinctrl-3 = <&sub_cam_en_out &sub_cam_1p0_out &sub_cam_io_out &sub_cam_af_out &sub_cam_rst_out>;
		pinctrl-4;
		position = <0x02>;
		id = <0x02>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x02>;
		sensor_i2c_addr = <0x5a>;
		gpio_mclk = <&gpk0 0x00 0x01>;
		gpio_reset = <&gpc1 0x02 0x01>;
		gpio_ois_reset = <&gpc1 0x00 0x01>;
		gpio_camio_1p8_en = <&gpe7 0x07 0x01>;
		gpio_cam_1p0_en = <&gpe6 0x03 0x01>;
		gpio_cam_af_2p8_en = <&gpf1 0x00 0x01>;
		gpio_cam_2p8_en = <&gpc1 0x03 0x01>;
		power_seq_id = <0x01>;
		status = "okay";

		af {
			product_name = <0x11>;
			i2c_addr = <0x1e>;
			i2c_ch = <0x03>;
		};

		flash {
			product_name = <0x03>;
			flash_first_gpio = <0x01>;
			flash_second_gpio = <0x02>;
		};

		preprocessor {
			product_name = <0x64>;
		};

		ois {
			product_name = <0x02>;
			i2c_addr = <0x48>;
			i2c_ch = <0x01>;
		};

		internal_vc {
			vc_list = <0x01 0x01 0x00>;
		};
	};

	fimc-is_sensor_imx320_c3@20 {
		compatible = "samsung,sensor-module-imx320-c3";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_mclk1_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_mclk1_fn &fimc_is_mclk2_fn>;
		pinctrl-3 = <&comp_rst_out &vtcam_rst_out>;
		pinctrl-4;
		position = <0x01>;
		id = <0x00>;
		mclk_ch = <0x01>;
		sensor_i2c_ch = <0x01>;
		sensor_i2c_addr = <0x20>;
		use_initial_ae;
		gpio_mclk = <&gpk0 0x01 0x01>;
		gpio_reset = <&gpc0 0x03 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		status = "okay";

		af {
			product_name = <0x10>;
			i2c_addr = <0x18>;
			i2c_ch = <0x04>;
		};

		flash {
			product_name = <0x64>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x64>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	fimc-is_sensor_3h1_c3@6A {
		compatible = "samsung,sensor-module-3h1-c3";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_mclk1_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_mclk1_fn &fimc_is_mclk2_fn>;
		pinctrl-3 = <&comp_rst_out &vtcam_rst_out>;
		pinctrl-4;
		position = <0x01>;
		id = <0x00>;
		mclk_ch = <0x01>;
		sensor_i2c_ch = <0x01>;
		sensor_i2c_addr = <0x6a>;
		use_initial_ae;
		gpio_mclk = <&gpk0 0x01 0x01>;
		gpio_reset = <&gpc0 0x03 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		status = "okay";

		af {
			product_name = <0x10>;
			i2c_addr = <0x18>;
			i2c_ch = <0x04>;
		};

		flash {
			product_name = <0x64>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x64>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	fimc-is_sensor_imx320@20 {
		compatible = "samsung,sensor-module-imx320";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_mclk1_out>;
		pinctrl-2 = <&fimc_is_mclk1_fn>;
		pinctrl-3 = <&vtcam_rst_out>;
		pinctrl-4;
		position = <0x01>;
		id = <0x01>;
		mclk_ch = <0x01>;
		sensor_i2c_ch = <0x01>;
		sensor_i2c_addr = <0x20>;
		use_initial_ae;
		gpio_mclk = <&gpk0 0x01 0x01>;
		gpio_reset = <&gpc0 0x03 0x01>;
		status = "okay";

		af {
			product_name = <0x10>;
			i2c_addr = <0x18>;
			i2c_ch = <0x04>;
		};

		flash {
			product_name = <0x64>;
		};

		preprocessor {
			product_name = <0x64>;
		};

		ois {
			product_name = <0x64>;
		};

		internal_vc {
		};
	};

	fimc-is_sensor_3h1@6A {
		compatible = "samsung,sensor-module-3h1";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_mclk1_out>;
		pinctrl-2 = <&fimc_is_mclk1_fn>;
		pinctrl-3 = <&vtcam_rst_out>;
		pinctrl-4;
		position = <0x01>;
		id = <0x01>;
		mclk_ch = <0x01>;
		sensor_i2c_ch = <0x01>;
		sensor_i2c_addr = <0x6a>;
		use_initial_ae;
		gpio_mclk = <&gpk0 0x01 0x01>;
		gpio_reset = <&gpc0 0x03 0x01>;
		status = "okay";

		af {
			product_name = <0x10>;
			i2c_addr = <0x18>;
			i2c_ch = <0x04>;
		};

		flash {
			product_name = <0x64>;
		};

		preprocessor {
			product_name = <0x64>;
		};

		ois {
			product_name = <0x64>;
		};

		internal_vc {
		};
	};
};

&{/thermal-zones/isp-thermal} {
	trips {
		isp_t100: isp-100 {
			temperature = <100000>;
			hysteresis = <5000>;
			type = "active";
		};

		isp_t105: isp-105 {
			temperature = <105000>;
			hysteresis = <5000>;
			type = "active";
		};
	};

	cooling-maps {
		map-100 {
			trip = <&isp_t100>;
			cooling-device = <&fimc_is 1 1>;
		};

		map-105 {
			trip = <&isp_t105>;
			cooling-device = <&fimc_is 2 2>;
		};
	};
};

&cmu_cam {
	status = "okay";
};

&cmu_dcam {
	status = "okay";
};

&cmu_isphq {
	status = "okay";
};

&cmu_isplp {
	status = "okay";
};

&cmu_srdz {
	status = "okay";
};

&fimc_is {
	pinctrl-names = "default", "release";
	pinctrl-0 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk1_out &fimc_is_mclk2_out &fimc_is_mclk3_out>;
	pinctrl-1;
	chain_config = <1>;
	status = "okay";

	vender {
		rear_sensor_id = <0x20>;
		front_sensor_id = <0x1f>;
		rear_second_sensor_id = <0x21>;
		secure_sensor_id = <0xfe>;
		use_module_check;
		use_ois_hsi2c;
		use_ois;
		check_sensor_vendor;
		f_rom_power = <0x01>;
		max_camera_num = <0x04>;

		camera_info0 {
			isp = <0x00>;
			cal_memory = <0x01>;
			read_version = <0x00>;
			core_voltage = <0x01>;
			upgrade = <0x00>;
			fw_write = <0x00>;
			fw_dump = <0x00>;
			companion = <0x01>;
			ois = <0x01>;
			valid = <0x01>;
			dual_open = <0x00>;
		};

		camera_info1 {
			isp = <0x00>;
			cal_memory = <0x02>;
			read_version = <0x00>;
			core_voltage = <0x00>;
			upgrade = <0x00>;
			fw_write = <0x00>;
			fw_dump = <0x00>;
			companion = <0x01>;
			ois = <0x00>;
			valid = <0x01>;
			dual_open = <0x00>;
		};

		camera_info2 {
			isp = <0x00>;
			cal_memory = <0x01>;
			read_version = <0x00>;
			core_voltage = <0x00>;
			upgrade = <0x00>;
			fw_write = <0x00>;
			fw_dump = <0x00>;
			companion = <0x00>;
			ois = <0x01>;
			valid = <0x01>;
			dual_open = <0x01>;
		};

		camera_info3 {
			isp = <0x02>;
			cal_memory = <0x00>;
			read_version = <0x01>;
			core_voltage = <0x00>;
			upgrade = <0x00>;
			fw_write = <0x00>;
			fw_dump = <0x00>;
			companion = <0x00>;
			ois = <0x00>;
			valid = <0x01>;
			dual_open = <0x00>;
		};
	};

	fimc_is_dvfs {
		table0 {
			desc = "dvfs table v0.0 for 12M/8M";
			default_int_cam = <0xa8750>;
			default_cam = <0xa8750>;
			default_mif = <0x1fefc8>;
			default_int = <0xa2d78>;
			default_i2c = <0x00>;
			default_hpg = <0x01>;
			front_preview_int_cam = <0xa3930>;
			front_preview_cam = <0x9eb10>;
			front_preview_mif = <0xf78f0>;
			front_preview_int = <0x1a1f8>;
			front_preview_i2c = <0x00>;
			front_preview_hpg = <0x01>;
			front_capture_int_cam = <0xa3930>;
			front_capture_cam = <0x9eb10>;
			front_capture_mif = <0xf78f0>;
			front_capture_int = <0x1a1f8>;
			front_capture_i2c = <0x00>;
			front_capture_hpg = <0x01>;
			front_video_int_cam = <0xa3930>;
			front_video_cam = <0x9eb10>;
			front_video_mif = <0xf78f0>;
			front_video_int = <0x1a1f8>;
			front_video_i2c = <0x00>;
			front_video_hpg = <0x01>;
			front_video_whd_int_cam = <0xa3930>;
			front_video_whd_cam = <0x9eb10>;
			front_video_whd_mif = <0xf78f0>;
			front_video_whd_int = <0x1a1f8>;
			front_video_whd_i2c = <0x00>;
			front_video_whd_hpg = <0x01>;
			front_video_capture_int_cam = <0xa3930>;
			front_video_capture_cam = <0x9eb10>;
			front_video_capture_mif = <0xf78f0>;
			front_video_capture_int = <0x1a1f8>;
			front_video_capture_i2c = <0x00>;
			front_video_capture_hpg = <0x01>;
			front_video_whd_capture_int_cam = <0xa3930>;
			front_video_whd_capture_cam = <0x9eb10>;
			front_video_whd_capture_mif = <0xf78f0>;
			front_video_whd_capture_int = <0x1a1f8>;
			front_video_whd_capture_i2c = <0x00>;
			front_video_whd_capture_hpg = <0x01>;
			front_no_preproc_int_cam = <0xa3930>;
			front_no_preproc_cam = <0x9eb10>;
			front_no_preproc_mif = <0xf78f0>;
			front_no_preproc_int = <0x1a1f8>;
			front_no_preproc_i2c = <0x00>;
			front_no_preproc_hpg = <0x01>;
			front_vt1_int_cam = <0xa3930>;
			front_vt1_cam = <0x9eb10>;
			front_vt1_mif = <0xf78f0>;
			front_vt1_int = <0x1a1f8>;
			front_vt1_i2c = <0x00>;
			front_vt1_hpg = <0x01>;
			front_vt2_int_cam = <0xa3930>;
			front_vt2_cam = <0x9eb10>;
			front_vt2_mif = <0xf78f0>;
			front_vt2_int = <0x1a1f8>;
			front_vt2_i2c = <0x00>;
			front_vt2_hpg = <0x01>;
			front_vt4_int_cam = <0xa3930>;
			front_vt4_cam = <0x9eb10>;
			front_vt4_mif = <0xf78f0>;
			front_vt4_int = <0x1a1f8>;
			front_vt4_i2c = <0x00>;
			front_vt4_hpg = <0x01>;
			rear2_preview_fhd_int_cam = <0xa6040>;
			rear2_preview_fhd_cam = <0xa3930>;
			rear2_preview_fhd_mif = <0xf78f0>;
			rear2_preview_fhd_int = <0x1a1f8>;
			rear2_preview_fhd_i2c = <0x00>;
			rear2_preview_fhd_hpg = <0x01>;
			rear2_capture_int_cam = <0xa6040>;
			rear2_capture_cam = <0xa3930>;
			rear2_capture_mif = <0xf78f0>;
			rear2_capture_int = <0x1a1f8>;
			rear2_capture_i2c = <0x00>;
			rear2_capture_hpg = <0x01>;
			rear2_video_fhd_int_cam = <0xa6040>;
			rear2_video_fhd_cam = <0xa3930>;
			rear2_video_fhd_mif = <0xf78f0>;
			rear2_video_fhd_int = <0x1a1f8>;
			rear2_video_fhd_i2c = <0x00>;
			rear2_video_fhd_hpg = <0x01>;
			rear2_video_fhd_capture_int_cam = <0xa6040>;
			rear2_video_fhd_capture_cam = <0xa3930>;
			rear2_video_fhd_capture_mif = <0xf78f0>;
			rear2_video_fhd_capture_int = <0x1a1f8>;
