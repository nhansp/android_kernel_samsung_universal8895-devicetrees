&fimc_is_sensor0 {
	status = "okay";
};

&fimc_is_sensor1 {
	status = "okay";
};

&fimc_is_sensor2 {
	status = "okay";
};

&fimc_is_sensor3 {
	status = "okay";
};

&hsi2c_1 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default", "on_i2c", "off_i2c";
	pinctrl-0 = <&hsi2c1_bus_in>;
	pinctrl-1 = <&hsi2c1_bus>;
	pinctrl-2 = <&hsi2c1_bus_in>;
	clock-frequency = <400000>;
	status = "okay";

	fimc-is-preprocessor@3d {
		compatible = "samsung,fimc_is_i2c0";
		reg = <0x3d>;
	};

	fimc-is-imx333@1a {
		compatible = "samsung,exynos5-fimc-is-cis-imx333";
		reg = <0x1a>;
		id = <0x00>;
		setfile = "setA";
	};

	fimc-is-2l2@2d {
		compatible = "samsung,exynos5-fimc-is-cis-2l2";
		reg = <0x2d>;
		id = <0x00>;
		setfile = "setB";
	};
};

&hsi2c_2 {
	#address-cells = <1>;
