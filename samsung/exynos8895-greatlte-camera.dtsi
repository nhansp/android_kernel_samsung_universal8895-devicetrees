			pip_video_capture_i2c = <0x00>;
			preview_high_speed_fps_int_cam = <0xa8750>;
			preview_high_speed_fps_cam = <0xa8750>;
			preview_high_speed_fps_mif = <0xf78f0>;
			preview_high_speed_fps_int = <0x2b750>;
			preview_high_speed_fps_i2c = <0x00>;
			video_high_speed_60fps_int_cam = <0xa8750>;
			video_high_speed_60fps_cam = <0xa8750>;
			video_high_speed_60fps_mif = <0xf78f0>;
			video_high_speed_60fps_int = <0x2b750>;
			video_high_speed_60fps_i2c = <0x00>;
			video_high_speed_120fps_int_cam = <0xa8750>;
			video_high_speed_120fps_cam = <0xa8750>;
			video_high_speed_120fps_mif = <0xf78f0>;
			video_high_speed_120fps_int = <0x2b750>;
			video_high_speed_120fps_i2c = <0x00>;
			video_high_speed_240fps_int_cam = <0xa8750>;
			video_high_speed_240fps_cam = <0xa8750>;
			video_high_speed_240fps_mif = <0x1b5fd0>;
			video_high_speed_240fps_int = <0x61a80>;
			video_high_speed_240fps_i2c = <0x00>;
			max_int_cam = <0xa8750>;
			max_cam = <0xa8750>;
			max_mif = <0x1fefc8>;
			max_int = <0xa2d78>;
			max_i2c = <0x00>;
		};
	};
