/*
 * Samsung Galaxy Note 8 (SM-N950N) display
 */

#include <dt-bindings/gpio/gpio.h>

/ {
	spi_gpio: spi {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sck-gpios = <&gpe5 3 GPIO_ACTIVE_HIGH>;
		miso-gpios = <&gpe5 0 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpe5 1 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&gpe5 2 GPIO_ACTIVE_HIGH>;
		num-chipselects = <1>;

		panel_spi@0 {
			compatible = "panel_spi";
			reg = <0>;
			spi-max-frequency = <1200000>;
			bits-per-word = <8>;
		};
	};
};

&{/chosen} {
	#address-cells = <2>;
	#size-cells = <1>;
	ranges;

	framebuffer0: framebuffer@cc000000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0xcc000000 (1440 * 2960 * 4)>;
		width = <1440>;
		height = <2960>;
		stride = <(1440 * 4)>;
		format = "a8r8g8b8";
		power-domains = <&pd_dpu0>, <&pd_dpu1>;
		vddi3p0-supply = <&s2dos03_ldo3>;
		vddi1p8-supply = <&s2dos03_ldo1>;
		vddi1p6-supply = <&s2dos03_buck1>;
		status = "disabled";
	};
};

&cmu_dpu0 {
	status = "okay";
};

&decon {
	memory-region = <&splash_mem>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&decon_f_te_on>;
	pinctrl-1 = <&decon_f_te_off>;
	status = "okay";

	cam-stat@16484024 {
		reg = <0x00 0x16484024 0x04>;
	};
};

&dsi {
	samsung,burst-clock-frequency = <898000000>;
	samsung,esc-clock-frequency = <20000000>;
	samsung,cmd-underrun-lp-ref = <0xbce>;
	status = "okay";

	ports {
		port@1 {
			reg = <1>;

			dsi_to_panel: endpoint {
				remote-endpoint = <&panel_from_dsi>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	panel: panel@0 {
		compatible = "samsung,s6e3ha6";
		reg = <0>;
		reset-gpios = <&gpa0 5 GPIO_ACTIVE_LOW>;
		disp-det-gpios = <&gpi1 1 GPIO_ACTIVE_HIGH>;
		te-gpios = <&gpb0 1 GPIO_ACTIVE_HIGH>;
		vddi3p0-supply = <&s2dos03_ldo3>;
		vddi1p8-supply = <&s2dos03_ldo1>;
		vddi1p6-supply = <&s2dos03_buck1>;
		width-mm = <71>;
		height-mm = <145>;
		dsu_en = <1>;
		dsu_number = <2>;
		dsu_width = <1440 1080 720>;
		dsu_height = <2960 2220 1480>;
		dsu_dsc_width = <720 540 360>;
		dsu_dsc_height = <40 30 74>;
		dsu_dsc_en = <1 1 0>;

		port {
			panel_from_dsi: endpoint {
				remote-endpoint = <&dsi_to_panel>;
			};
		};
	};
};

&hsi2c_16 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	s2dos03: pmic@60 {
		compatible = "samsung,s2dos03";
		reg = <0x60>;

		regulators {
			s2dos03_buck1: buck1 {
				regulator-name = "vdd_ddi_1p6";
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <1600000>;
				regulator-boot-on;
			};

			s2dos03_ldo1: ldo1 {
				regulator-name = "vdd_ddi_1p8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};

			s2dos03_ldo3: ldo3 {
				regulator-name = "vdd_ddi_3p0";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;
			};

			s2dos03_ldo2: ldo2 {
				regulator-name = "HRM_1.8V_AP";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			s2dos03_ldo4: ldo4 {
				regulator-name = "HRM_3.3V_AP";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};
		};
	};
};

&mipi_phy {
	status = "okay";
};

&pd_dpu0 {
	status = "okay";
};

&pd_dpu1 {
	status = "okay";
};

&pinctrl_peric1 {
	decon_f_te_on: decon-f-te-on-pins {
		samsung,pins = "gpb0-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
	};

	decon_f_te_off: decon-f-te-off-pins {
		samsung,pins = "gpb0-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
	};
};

&sysmmu_dpu0 {
	status = "okay";
};

&sysmmu_dpu1 {
	status = "okay";
};

&sysmmu_dpu2 {
	status = "okay";
};
