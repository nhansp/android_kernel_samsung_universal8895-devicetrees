				 <&cmu_top CLK_DOUT_CMU_HPM>;
			clock-names = "oscclk", "switch", "hpm";
			status = "disabled";
		};

		cmu_g2d: clock-controller@13a00000 {
			compatible = "samsung,exynos8895-cmu-g2d";
			reg = <0x13a00000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_G2D_G2D>,
				 <&cmu_top CLK_DOUT_CMU_G2D_JPEG>;
			clock-names = "oscclk", "g2d", "jpeg";
			assigned-clocks = <&cmu_g2d CLK_MOUT_G2D_G2D_USER>, <&cmu_g2d CLK_MOUT_G2D_JPEG_USER>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_G2D_G2D>, <&cmu_top CLK_DOUT_CMU_G2D_JPEG>;
			power-domains = <&pd_g2d>;
			status = "disabled";
		};

		cmu_mfc: clock-controller@13c00000 {
			compatible = "samsung,exynos8895-cmu-mfc";
			reg = <0x13c00000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_MFC_BUS>;
			clock-names = "oscclk", "bus";
			assigned-clocks = <&cmu_mfc CLK_MOUT_MFC_BUS_USER>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_MFC_BUS>;
			power-domains = <&pd_mfc>;
			status = "disabled";
