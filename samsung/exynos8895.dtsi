			compatible = "samsung,exynos8895-cmu-top";
			reg = <0x15a80000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>;
			clock-names = "oscclk";
		};

		mcinfo: mcinfo@1603004c {
			compatible = "samsung,exynos8895-mcinfo";
			reg = <0x1603004c 0x4>, <0x1613004c 0x4>,
			      <0x1623004c 0x4>, <0x1633004c 0x4>;
			interrupts = <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 122 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		cmu_apm: clock-controller@16400000 {
			compatible = "samsung,exynos8895-cmu-apm";
			reg = <0x16400000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_APM_BUS>;
			clock-names = "oscclk", "bus";
